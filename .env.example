OMEGA_HOST=127.0.0.1
OMEGA_PORT=8127
OMEGA_DATA=./runtime-data
OMEGA_CORPUS_ROOT=
OMEGA_GATEWAY_TOKEN=

# Local canonical WebSocket heartbeat. Keep loopback unless deliberately fronted by an authenticated gateway.
OMEGA_STREAM_ENABLED=1
OMEGA_STREAM_HOST=127.0.0.1
OMEGA_STREAM_PORT=8128

# Semicolon-separated roots Hybrid Link and workbook operations may access.
OMEGA_HYBRID_ROOTS=.

# Optional Windows installer override. Default is C:\OMEGA_INSTALL\OMEGA_ONE_SYSTEM.
OMEGA_INSTALL_ROOT=
